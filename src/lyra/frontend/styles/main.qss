/* =====================================================
   TEMA: todo lo que parsea ThemeManager (@TOKEN)
   ===================================================== */

/* ===== GLOBAL / FONDOS ===== */
QWidget { color: @TEXT; }

QWidget#playerPanel { background-color: @PLAYER_BG; }
QWidget#contentContainer { background-color: @CONTENT_BG; }

/* ===== TYPOGRAPHY ===== */
QLabel#h1 {
    color: @PRIMARY;
    font-family: @H1_FONTS;
    font-size: @H1_SIZE;
    font-weight: @H1_WEIGHT;
}

QLabel#h2 {
    color: @TEXT;
    font-family: @H2_FONTS;
    font-size: @H2_SIZE;
    font-weight: @H2_WEIGHT;
}

QLabel#h3 {
    color: @TEXT;
    font-family: @H3_FONTS;
    font-size: @H3_SIZE;
    font-weight: @H3_WEIGHT;
}

QLabel#label {
    color: @TEXT;
    font-family: @LABEL_FONTS;
    font-size: @LABEL_SIZE;
    font-weight: @LABEL_WEIGHT;
}

QLabel#info {
    color: @INFO;
    font-family: @INFO_FONTS;
    font-size: @INFO_SIZE;
    font-weight: @INFO_WEIGHT;
}

QLabel#inactive {
    color: @INACTIVE;
    font-family: @INACTIVE_FONTS;
    font-size: @INACTIVE_SIZE;
    font-weight: @INACTIVE_WEIGHT;
}

/* ===== BUTTONS ===== */
QPushButton {
    background-color: @SURFACE;
    color: @TEXT;
}

QPushButton:hover { background-color: @HOVER; }
QPushButton:pressed { background-color: @TERTIARY; }
QPushButton:focus { background-color: @HOVER; }
QPushButton:checked { background-color: @PRIMARY; }

QPushButton:disabled {
    color: @INACTIVE;
    background-color: @CONTENT_BG;
}

/* ===== INPUTS ===== */
QLineEdit {
    background-color: @SURFACE;
    color: @TEXT;
    selection-background-color: @PRIMARY;
}

QLineEdit:hover { border-color: @HOVER; }
QLineEdit:focus { border: 1px solid @SECONDARY; }

QLineEdit:read-only {
    background-color: @SURFACE;
    color: @TEXT;
    border-color: @HOVER;
}

/* ===== SLIDERS ===== */
QSlider#appSlider::groove:horizontal,
QSlider#seekSlider::groove:horizontal,
QSlider#clickableSlider::groove:horizontal {
    background-color: @HOVER;
}

QSlider#appSlider::sub-page:horizontal,
QSlider#seekSlider::sub-page:horizontal,
QSlider#clickableSlider::sub-page:horizontal {
    background-color: @PRIMARY;
}

QSlider#appSlider::handle:horizontal:pressed,
QSlider#seekSlider::handle:horizontal:pressed,
QSlider#clickableSlider::handle:horizontal:pressed {
    background-color: @SECONDARY;
}

/* disabled: pseudo-elemento primero, estado después */
QSlider#appSlider::sub-page:horizontal:disabled { background-color: @INACTIVE; }
QSlider#appSlider::handle:horizontal:disabled { background-color: @INACTIVE; }

/* ===== SCROLLBARS ===== */
QScrollBar::handle:vertical { background: @HOVER; }
QScrollBar::handle:vertical:hover { background: @INFO; }
QScrollBar::handle:vertical:pressed { background: @SECONDARY; }

QScrollBar::handle:horizontal { background: @HOVER; }
QScrollBar::handle:horizontal:hover { background: @INFO; }
QScrollBar::handle:horizontal:pressed { background: @SECONDARY; }

/* ===== PLAYER ===== */
QToolButton { color: @INFO; }

QToolButton:hover {
    background-color: @HOVER;
    color: @TEXT;
}

QToolButton:pressed {
    background-color: @TERTIARY;
    color: @TEXT;
}

QToolButton:checked { color: @SECONDARY; }
QToolButton:disabled { color: @INACTIVE; }

QLabel#seekCurrentTime,
QLabel#seekTotalTime { color: @INACTIVE; }

/* ===== LYRICS ===== */
QWidget#lyricItem QLabel#lyric {
    color: @INFO;
    font-family: @LYRIC_FONTS;
    font-size: @LYRIC_SIZE;
    font-weight: @LYRIC_WEIGHT;
}

/* inactiva + hover */
QWidget#lyricItem[hovered="true"] { background-color: @HOVER; }
QWidget#lyricItem[hovered="true"] QLabel#lyric { color: @TEXT; }

/* activa (después del hover, para ganarle) */
QWidget#lyricItem[active="true"] QLabel#lyric {
    color: @SECONDARY;
    font-family: @LYRIC_ACTIVE_FONTS;
    font-size: @LYRIC_ACTIVE_SIZE;
    font-weight: @LYRIC_ACTIVE_WEIGHT;
}

/* ===== LIBRARY ===== */
QWidget#trackItem:hover { background-color: @HOVER; }


/* =====================================================
   ESTÁTICO: sin tokens, no depende del tema
   ===================================================== */

/* ===== GLOBAL ===== */
QWidget {
    font-family: "Inter", "Segoe UI", "Noto Sans", sans-serif;
    font-size: 15px;
}

/* ===== BUTTONS (sin borde, pill) ===== */
QPushButton {
    border: none;
    outline: none;
    border-radius: 18px;
    padding: 10px 22px;
    font-size: 14px;
    font-weight: 600;
}

/* ===== INPUTS ===== */
QLineEdit {
    border: 1px solid transparent;
    border-radius: 14px;
    padding: 11px 16px;
    font-size: 14px;
}

/* ===== SLIDERS (riel 6px · handle 10px, 14px hover) ===== */
QSlider#appSlider:horizontal,
QSlider#seekSlider:horizontal,
QSlider#clickableSlider:horizontal {
    background: transparent;
    border: none;
    min-height: 22px;
}

QSlider#appSlider::groove:horizontal,
QSlider#seekSlider::groove:horizontal,
QSlider#clickableSlider::groove:horizontal {
    border: none;
    height: 6px;
    border-radius: 3px;
}

QSlider#appSlider::sub-page:horizontal,
QSlider#seekSlider::sub-page:horizontal,
QSlider#clickableSlider::sub-page:horizontal {
    border-radius: 3px;
}

QSlider#appSlider::add-page:horizontal,
QSlider#seekSlider::add-page:horizontal,
QSlider#clickableSlider::add-page:horizontal {
    background: transparent;
}

QSlider#appSlider::handle:horizontal,
QSlider#seekSlider::handle:horizontal,
QSlider#clickableSlider::handle:horizontal {
    background-color: white;
    border: none;
    width: 10px;
    height: 10px;
    margin: -2px 0;
    border-radius: 5px;
}

QSlider#appSlider::handle:horizontal:hover,
QSlider#seekSlider::handle:horizontal:hover,
QSlider#clickableSlider::handle:horizontal:hover {
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

QSlider#appSlider::handle:horizontal:pressed,
QSlider#seekSlider::handle:horizontal:pressed,
QSlider#clickableSlider::handle:horizontal:pressed {
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

/* ===== SCROLLBARS ===== */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    border-radius: 2px;
    min-height: 36px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    border-radius: 2px;
    min-width: 36px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; }

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal { background: transparent; }

/* ===== PLAYER ===== */
QWidget#albumArt {
    background-color: transparent;
    border-radius: 14px;
}

QWidget#trackInfo { background-color: transparent; }
QWidget#playbackControls { background-color: transparent; }

QToolButton {
    background-color: transparent;
    border: none;
    outline: none;
    border-radius: 20px;
    padding: 10px;
}

QWidget#seekBar { background-color: transparent; }

QLabel#seekCurrentTime,
QLabel#seekTotalTime {
    font-size: 13px;
    font-weight: 500;
}

/* ===== LYRICS ===== */
QWidget#lyricsPanel { background-color: transparent; }

QScrollArea#lyricsScrollArea {
    background-color: transparent;
    border: none;
}

QWidget#lyricsList { background-color: transparent; }

/* inactiva */
QWidget#lyricItem {
    background-color: transparent;
    border-radius: 14px;
    border-left: 4px solid transparent;
}

QWidget#lyricItem QLabel#lyric { background-color: transparent; }

/* activa (después del hover, que está arriba, para ganarle) */
QWidget#lyricItem[active="true"] { background-color: transparent; }

/* ===== LIBRARY ===== */
QWidget#libraryPanel { background-color: transparent; }

QScrollArea#libraryScrollArea {
    background-color: transparent;
    border: none;
}

QWidget#libraryList { background-color: transparent; }

QWidget#trackItem {
    background-color: transparent;
    border-radius: 14px;
}

QWidget#trackItem QLabel { background-color: transparent; }

/* ===== CONFIGURATION ===== */
QWidget#configHeader { background-color: transparent; }
QWidget#configSections { background-color: transparent; }

QScrollArea#configScrollArea {
    background-color: transparent;
    border: none;
}

QWidget#libraryPathEntry { background-color: transparent; }
QWidget#themeSection { background-color: transparent; }
QWidget#fontsSection { background-color: transparent; }
QWidget#colorEntry { background-color: transparent; }
QWidget#fontEntry { background-color: transparent; }

/* muestras de color: círculo 30x30, sin borde */
QWidget#colorEntry QPushButton {
    border: none;
    border-radius: 15px;
    padding: 0;
}
