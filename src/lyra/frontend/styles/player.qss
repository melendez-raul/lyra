
/*
========================================
PLAYER
========================================
*/


/* =====================================
   PLAYER PANEL
===================================== */

#playerPanel {
    background-color: @PLAYER_SURFACE;
    border: none;
}


/* =====================================
   ALBUM ART
===================================== */

#albumArt {
    background-color: @SURFACE;
    border: none;
    border-radius: 14px;
}


/* =====================================
   TRACK INFORMATION
===================================== */

QWidget#trackInfo {
    background: transparent;
    border: none;
}

QLabel#trackTitle {
    color: @TITLE_COLOR;
    background: transparent;
    font-family: "Bricolage Grotesque";
    font-size: 30px;
    font-weight: 700;
}

QLabel#trackArtist {
    color: @TEXT_SECONDARY;
    background: transparent;
    font-family: "Inter";
    font-size: 24px;
    font-weight: 500;
}

QLabel#trackAlbum {
    color: @TEXT_MUTED;
    background: transparent;
    font-family: "Inter";
    font-size: 18px;
    font-weight: 400;
}


/* =====================================
   SEEK BAR
===================================== */

#seekBar {
    background: transparent;
    border: none;
}

#seekSlider {
    background: transparent;
    border: none;
    min-height: 24px;
    padding: 0;
}

/* Groove */

#seekSlider::groove:horizontal {
    background-color: @SURFACE_HOVER;
    height: 4px;
    border: none;
    border-radius: 2px;
}

/* Played */

#seekSlider::sub-page:horizontal {
    background-color: @ACCENT_PRIMARY;
    border: none;
    border-radius: 2px;
}

/* Remaining */

#seekSlider::add-page:horizontal {
    background-color: @SURFACE_HOVER;
    border: none;
    border-radius: 2px;
}

/* Handle */

#seekSlider::handle:horizontal {
    background-color: @TEXT_PRIMARY;
    border: none;
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
}

#seekSlider::handle:horizontal:hover {
    background-color: @ACCENT_PRIMARY;
}


/* =====================================
   SEEK TIME
===================================== */

#seekCurrentTime,
#seekTotalTime {
    color: @TEXT_MUTED;
    background: transparent;
    font-family: "Inter";
    font-size: 16px;
    font-weight: 500;
}


/* =====================================
   PLAYBACK CONTROLS
===================================== */

#playbackControls {
    background: transparent;
    border: none;
}


/* =====================================
   SECONDARY CONTROLS
===================================== */

QToolButton#previousButton,
QToolButton#nextButton {
    background-color: transparent;
    border: none;
    border-radius: 22px;

    min-width: 44px;
    max-width: 44px;
    min-height: 44px;
    max-height: 44px;

    padding: 0;
}

QToolButton#previousButton:hover,
QToolButton#nextButton:hover {
    background-color: @BORDER_SUBTLE;
}

QToolButton#previousButton:pressed,
QToolButton#nextButton:pressed {
    background-color: @ACCENT_TERTIARY;
}

QToolButton#previousButton:disabled,
QToolButton#nextButton:disabled {
    background-color: transparent;
}

/* =====================================
   PRIMARY CONTROL - PLAY / PAUSE
===================================== */

QToolButton#playButton {
    background-color: @ACCENT_PRIMARY;
    border: none;
    border-radius: 30px;

    min-width: 60px;
    max-width: 60px;
    min-height: 60px;
    max-height: 60px;

    padding: 0;
}

QToolButton#playButton:hover {
    background-color: @ACCENT_SECONDARY;
}

QToolButton#playButton:pressed {
    background-color: @ACCENT_TERTIARY;
}

QToolButton#playButton:disabled {
    background-color: @SURFACE_HOVER;
}
